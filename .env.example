# ==============================================================================
# DigiVio Workspace Environment Guide & Template
# Location: .env.example (Root)
# ==============================================================================
# DigiVio is structured as a decoupled full-stack architecture:
#   - Frontend (Next.js 14): Configure in `frontend/.env.local`
#   - Backend (Express + Supabase): Configure in `backend/.env`
#
# DO NOT commit real .env files to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Environment Variables (Place in frontend/.env.local)
# ------------------------------------------------------------------------------
# Public URL of the backend API for client-side fetches and Next.js API rewrites
NEXT_PUBLIC_API_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# Backend Environment Variables (Place in backend/.env)
# ------------------------------------------------------------------------------
# Server runtime settings
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Supabase Credentials (Project Settings -> API)
# Required for live PostgreSQL database and authentication.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage Buckets (Pre-configured defaults)
STORAGE_ARTWORK_BUCKET=uploads
STORAGE_PROOFS_BUCKET=previews
STORAGE_PRODUCTION_BUCKET=printfiles
STORAGE_INVOICES_BUCKET=invoices
STORAGE_GALLERY_BUCKET=gallery

# Stripe Payments (Stripe Dashboard -> Developers -> API Keys)
# Optional: backend simulates successful test checkout if left empty.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend Email Delivery (Resend Dashboard -> API Keys)
# Optional: backend logs notifications in-memory if left empty.
RESEND_API_KEY=
EMAIL_FROM=Digital Heroes <orders@digitalheroes.print>

# Commercial & GST Tax rate
TAX_RATE=0.18
