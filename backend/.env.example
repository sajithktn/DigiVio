# ==============================================================================
# DigiVio Backend Environment Template
# Location: backend/.env.example
# ==============================================================================
# Copy this file to backend/.env and supply your credentials.
# Safe to commit to version control. Contains NO live or demo secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Application Runtime
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Supabase Database & Authentication (Backend Secrets)
# ------------------------------------------------------------------------------
# Obtain from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 3. Supabase Storage Buckets
# ------------------------------------------------------------------------------
STORAGE_ARTWORK_BUCKET=uploads
STORAGE_PROOFS_BUCKET=previews
STORAGE_PRODUCTION_BUCKET=printfiles
STORAGE_INVOICES_BUCKET=invoices
STORAGE_GALLERY_BUCKET=gallery

# ------------------------------------------------------------------------------
# 4. Stripe Payment Gateway (Optional for local test mode)
# ------------------------------------------------------------------------------
# Obtain from: Stripe Dashboard -> Developers -> API keys & Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 5. Email Service - Resend (Optional for local test mode)
# ------------------------------------------------------------------------------
# Obtain from: Resend Dashboard -> API Keys (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=Digital Heroes <orders@digitalheroes.print>

# ------------------------------------------------------------------------------
# 6. Commercial & Tax Configuration
# ------------------------------------------------------------------------------
TAX_RATE=0.18
